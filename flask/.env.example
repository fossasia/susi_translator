FLASK_HOST=0.0.0.0
FLASK_PORT=5040
FLASK_DEBUG=false

# Replace with your actual production domain.
# For local dev only: http://localhost:5040,http://127.0.0.1:5040
CORS_ALLOWED_ORIGINS=https://yourdomain.example.com

SESSION_TTL_SECONDS=7200
TRANSCRIBE_AUTOSTART_WORKER=true

# Hugging Face Token
# Used to bypass anonymous rate limits when downloading the 250MB+ Supertonic TTS ONNX models.
# HF_TOKEN="your_huggingface_token_here"

# Rate-limiting storage
# REQUIRED for production: shared across all Gunicorn workers and persists across restarts.
# Without this the rate-limiter uses in-process memory — limits multiply per worker
# and all limits reset on restart.
REDIS_URL=redis://localhost:6379/0

# Reverse-proxy hops in front of this app (Nginx, Caddy, AWS ALB, …).
# Set to 1 when behind a single proxy so the rate-limiter sees real client IPs
# instead of the proxy's IP (which would bucket all users together).
# Leave at 0 (default) for direct / local development.
# TRUSTED_PROXY_COUNT=1

# Database
# SQLite (default — safe out-of-the-box, no extra driver needed).
# Run migrations before first start:
#   cd flask && uv run python -m flask --app transcribe_server.py db upgrade
DATABASE_URL=sqlite:///susi.db

# PostgreSQL (requires psycopg2-binary — already listed in pyproject.toml).
# Comment out the SQLite line above and uncomment this one to switch.
# DATABASE_URL=postgresql://susi_user:CHANGE_ME@localhost:5432/susi

# JWT/Auth
# REQUIRED: minimum 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_WITH_OUTPUT_OF_openssl_rand_-hex_32

JWT_COOKIE_SAMESITE=Lax

# Set to true when serving over HTTPS (use a reverse proxy like Nginx in prod).
# JWT_COOKIE_SECURE=false   # dev only
JWT_COOKIE_SECURE=true

# CSRF protection for cookie-based JWT. Automatically enabled when JWT_COOKIE_SECURE=true.
# When enabled, every POST/PUT/DELETE request from the frontend must include an
# X-CSRF-TOKEN header (the frontend already does this automatically)
# JWT_COOKIE_CSRF_PROTECT=true